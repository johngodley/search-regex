{
	"name": "search-regex",
	"version": "3.4.3",
	"description": "Adds search and replace functionality across posts, pages, comments, and meta-data, with full regular expression support",
	"main": "search-regex.php",
	"sideEffects": [
		"*.css",
		"*.scss",
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"build": "wp-scripts build",
		"build:analyze": "ANALYZE=true pnpm build",
		"build:stats": "wp-scripts build --webpack-bundle-analyzer",
		"lint": "pnpm lint:css && pnpm lint:js && pnpm lint:ts && pnpm lint:php",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js ./src",
		"lint:ts": "tsc --noEmit",
		"lint:php": "composer run-script checks",
		"plugin": "pnpm build && rm -rf release && mkdir -p release/search-regex && cp -R search-regex.php search-regex-loader.php changelog.txt readme.txt build license.txt includes release/search-regex",
		"plugin:zip": "pnpm plugin && cd release && zip -r search-regex.zip search-regex",
		"release": "dev/release-github.sh",
		"release:svn": "pnpm plugin && dev/svn.sh $npm_package_version",
		"start": "wp-scripts start",
		"test": "pnpm test:js && pnpm test:unit && pnpm test:integration",
		"test:unit": "composer run test-unit",
		"test:integration": "wp-env run cli --env-cwd=wp-content/plugins/search-regex composer run test-integration",
		"test:js": "wp-scripts test-unit-js",
		"doc": "redocly build-docs dev/openapi.yaml -o release/api-doc.html",
		"update": "pnpm update",
		"wp-env:start": "wp-env start",
		"wp-env:destroy": "wp-env destroy"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johngodley/search-regex.git"
	},
	"author": "John Godley",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/johngodley/search-regex/issues"
	},
	"homepage": "https://github.com/johngodley/search-regex",
	"devDependencies": {
		"@redocly/cli": "^1.34.17",
		"@tanstack/eslint-plugin-query": "^5.101.4",
		"@testing-library/react": "^16.3.2",
		"@testing-library/react-hooks": "^8.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-highlight-words": "^0.20.1",
		"@wordpress/base-styles": "^6.20.0",
		"@wordpress/env": "^11.11.0",
		"@wordpress/eslint-plugin": "^22.22.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/scripts": "^32.6.0",
		"@wordpress/stylelint-config": "^23.42.0",
		"eslint": "^8.57.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-jsdoc": "^61.7.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^16.4.0",
		"npm-check-updates": "^19.6.6",
		"path": "^0.12.7",
		"prettier": "npm:wp-prettier@3.0.3",
		"stylelint": "^16.26.1",
		"typescript": "^5.9.3",
		"webpack-bundle-analyzer": "^5.3.1",
		"webpack-shell-plugin-next": "^2.3.3"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@headlessui/react": "^2.2.10",
		"@internationalized/date": "^3.12.2",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^6.24.0",
		"clsx": "^2.1.1",
		"file-saver": "^2.0.5",
		"rc-progress": "^4.0.0",
		"rc-util": "^5.44.4",
		"react": "^18.3.1",
		"react-copy-to-clipboard": "^5.1.1",
		"react-day-picker": "^8.10.2",
		"react-delta": "^1.1.2",
		"react-dom": "^18.3.1",
		"react-focus-lock": "^2.13.7",
		"react-highlight-words": "^0.21.0",
		"react-popper": "^2.3.0",
		"react-textarea-autosize": "^8.5.9",
		"use-debounce": "^10.1.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"wordpress": {
		"supported": "6.6"
	},
	"lint-staged": {
		"*.php": [
			"composer lint",
			"composer format"
		],
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,scss}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
